#!/usr/bin/env python3
import sys
import struct
from pathlib import Path

ARCSEC_1_100_TO_DEG = 1.0 / (100.0 * 3600.0)
SEA_OFFSET = -20000
LAKE_OFFSET = -30000
NO_DATA_DEFAULT = -9999

def extract_elv_to_txt(elv_path: str):
    elv_path = Path(elv_path)
    out_path = elv_path.with_suffix(".txt")

    with open(elv_path, "rb") as f:
        endian = "<"

        # ---- General header (116 bytes) ----
        f.seek(0)
        gh = f.read(116)

        # Positions per document
        # Need: segment_name(14), lon_resolution(i at 72), lat_resolution(i at 76),
        # lon_first_post(i at 80), lat_first_post(i at 84), num_columns(i at 88), num_rows(i at 92)
        segment_name = struct.unpack_from(endian + "14s", gh, 14)[0].decode("ascii", errors="ignore").rstrip()

        lon_resolution = struct.unpack_from(endian + "i", gh, 72)[0]
        lat_resolution = struct.unpack_from(endian + "i", gh, 76)[0]
        lon_first_post = struct.unpack_from(endian + "i", gh, 80)[0]
        lat_first_post = struct.unpack_from(endian + "i", gh, 84)[0]
        num_columns = struct.unpack_from(endian + "i", gh, 88)[0]
        num_rows = struct.unpack_from(endian + "i", gh, 92)[0]

        # ---- Elevation file header (20 bytes) ----
        eh = f.read(20)
        # i version(i=0..3), i creation(4..7), h data_scale(8..9), h elevation_type(10..11),
        # h bytes_per_elev(12..13), h min(14..15), h max(16..17), h no_data(18..19)
        data_scale = struct.unpack_from(endian + "h", eh, 8)[0]
        bytes_per_elev = struct.unpack_from(endian + "h", eh, 12)[0]
        no_data = struct.unpack_from(endian + "h", eh, 18)[0]
        if no_data == 0x8000:  # rare/safety; ignore if not needed
            no_data = NO_DATA_DEFAULT

        # minimal assumption
        # per doc: bytes_per_elev is 2 (h)
        # record: counter(i) + min(h) + max(h) + lon_first(i) + lat_first(i) + N * elevation(h)
        rec_header_fmt = endian + "i h h i i"   # 16 bytes
        rec_header_size = struct.calcsize(rec_header_fmt)
        record_size = rec_header_size + 2 * num_columns

        lon_res_deg = lon_resolution * ARCSEC_1_100_TO_DEG

        with open(out_path, "w", encoding="utf-8", newline="\n") as out:
            # QGIS-friendly
            out.write("lon;lat;elev_m;elev_m_real;segment\n")

            scale_div = float(data_scale) if data_scale != 0 else 1.0

            # iterate row-major: records = num_rows
            for r in range(num_rows):
                block = f.read(record_size)
                counter, _min_rec, _max_rec, lon_first_rec, lat_first_rec = struct.unpack_from(rec_header_fmt, block, 0)
                posts_fmt = endian + f"{num_columns}h"
                posts = struct.unpack_from(posts_fmt, block, rec_header_size)

                lat_deg = lat_first_rec * ARCSEC_1_100_TO_DEG
                lon_start_deg = lon_first_rec * ARCSEC_1_100_TO_DEG

                for c, raw in enumerate(posts):
                    if raw == no_data:
                        continue

                    elev_m = raw / scale_div

                    # water offset correction (sea/lake)
                    # doc: if raw == offset + elev_m*scale then elev_real_m = (raw - offset)/scale
                    if raw <= SEA_OFFSET:
                        d_sea = abs(raw - SEA_OFFSET)
                        d_lake = abs(raw - LAKE_OFFSET)
                        if d_lake < d_sea:
                            elev_m_real = (raw - LAKE_OFFSET) / scale_div
                        else:
                            elev_m_real = (raw - SEA_OFFSET) / scale_div
                    else:
                        elev_m_real = elev_m

                    lon_deg = lon_start_deg + c * lon_res_deg
                    out.write(f"{lon_deg:.10f};{lat_deg:.10f};{elev_m:.3f};{elev_m_real:.3f};{segment_name}\n")

    print(f"OK -> {out_path}")

if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: python3 elv_extract_min.py <file.elv>")
        sys.exit(1)
    extract_elv_to_txt(sys.argv[1])
