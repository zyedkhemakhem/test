#!/usr/bin/env python3
import sys
import struct
from pathlib import Path

ARCSEC_1_100_TO_DEG = 1.0 / (100.0 * 3600.0)

SEA_OFFSET = -20000
LAKE_OFFSET = -30000


def read_exact(f, n):
    b = f.read(n)
    if len(b) != n:
        raise EOFError(f"Unexpected EOF (wanted {n}, got {len(b)})")
    return b


def detect_endian_and_check(f):
    """
    header:
      0..1: file type identifier (2 bytes signed short)
      2..3: byte order identifier (2 bytes signed short)
      4..5: byte order check value (2 bytes signed short) = 24575
    """
    f.seek(4)
    check_le = struct.unpack("<h", read_exact(f, 2))[0]
    f.seek(4)
    check_be = struct.unpack(">h", read_exact(f, 2))[0]

    if check_le == 24575:
        return "<"
    if check_be == 24575:
        return ">"
    raise ValueError("Bad byte order check value (expected 24575).")


def parse_general_header(f, endian):
    # 116 bytes
    f.seek(0)
    b = read_exact(f, 116)

    # layout per doc
    data_type_identifier = struct.unpack_from(f"{endian}h", b, 0)[0]
    # boi at 2; check value at 4 already validated
    segment_name_bytes = struct.unpack_from(f"{endian}14s", b, 14)[0]
    segment_name = segment_name_bytes.decode("ascii", errors="ignore").rstrip()

    lon_resolution = struct.unpack_from(f"{endian}i", b, 72)[0]
    lat_resolution = struct.unpack_from(f"{endian}i", b, 76)[0]
    lon_first_post = struct.unpack_from(f"{endian}i", b, 80)[0]
    lat_first_post = struct.unpack_from(f"{endian}i", b, 84)[0]
    num_columns = struct.unpack_from(f"{endian}i", b, 88)[0]
    num_rows = struct.unpack_from(f"{endian}i", b, 92)[0]

    return {
        "segment_name": segment_name,
        "lon_resolution": lon_resolution,
        "lat_resolution": lat_resolution,
        "lon_first_post": lon_first_post,
        "lat_first_post": lat_first_post,
        "num_columns": num_columns,
        "num_rows": num_rows,
        "data_type_identifier": data_type_identifier,
    }


def arcsec100_to_deg(v):
    return v * ARCSEC_1_100_TO_DEG


def water_offset_guess(raw, no_data):
    if raw == no_data:
        return None, None

    # Decide whether it's sea or lake based on closeness to known offsets.
    # Elevations are raw = offset + (height_m * data_scale), so raw is offset-like.
    # We'll use the rule: if raw <= -20000, likely water.
    if raw <= SEA_OFFSET:
        d_sea = abs(raw - SEA_OFFSET)
        d_lake = abs(raw - LAKE_OFFSET)
        if d_lake < d_sea:
            return LAKE_OFFSET, raw - LAKE_OFFSET
        else:
            return SEA_OFFSET, raw - SEA_OFFSET

    return None, None


def extract_elv_to_txt(elv_path, txt_path):
    elv_path = Path(elv_path)
    txt_path = Path(txt_path)

    with open(elv_path, "rb") as f:
        endian = detect_endian_and_check(f)
        gh = parse_general_header(f, endian)

        if gh["data_type_identifier"] != 1:
            raise ValueError(f"Not an elevation file (data_type_identifier={gh['data_type_identifier']})")

        # elevation file header (20 bytes)
        # 0 version(i), 4 creation(i),
        # 8 data scale(h), 10 elevation type(h),
        # 12 bytes per elevation(h),
        # 14 min segment(h), 16 max segment(h), 18 no_data(h)
        eh = read_exact(f, 20)
        (ev_ver, ev_date,
         data_scale,
         _elev_type,
         bytes_per_elev,
         _min_seg,
         _max_seg,
         no_data) = struct.unpack(f"{endian}ii h h h h h h", eh)

        if bytes_per_elev != 2:
            raise NotImplementedError(f"Only bytes_per_elev=2 supported, got {bytes_per_elev}")

        num_rows = gh["num_rows"]
        num_cols = gh["num_columns"]

        # record:
        # counter(i) + min(h) + max(h) + lon_first(i) + lat_first(i) => 14 bytes
        # + num_cols elevation posts (each h=2 bytes)
        rec_prefix_fmt = f"{endian}i h h i i"  # 14 bytes
        rec_prefix_size = struct.calcsize(rec_prefix_fmt)
        rec_size = rec_prefix_size + 2 * num_cols

        posts_fmt = f"{endian}{num_cols}h"

        # Convert scale: meters = raw / data_scale
        scale_divisor = float(data_scale) if data_scale != 0 else 1.0

        # Precompute resolutions in degrees
        lon_res_deg = arcsec100_to_deg(gh["lon_resolution"])
        lat_first_deg = arcsec100_to_deg(gh["lat_first_post"])

        # Note: lon/lat in each record are given too (lon_first_record, lat_first_record).
        # We'll use those (more correct with potential variation).
        with open(txt_path, "w", encoding="utf-8", newline="\n") as out:
            # CSV-like ; separator, easy for QGIS
            out.write("lon;lat;elev_raw;elev_m;water_offset;elev_m_real\n")

            for r in range(num_rows):
                block = read_exact(f, rec_size)
                counter, _min_rec, _max_rec, lon_first_rec, lat_first_rec = struct.unpack_from(rec_prefix_fmt, block, 0)
                posts = struct.unpack_from(posts_fmt, block, rec_prefix_size)

                lat_deg = arcsec100_to_deg(lat_first_rec)
                lon_start_deg = arcsec100_to_deg(lon_first_rec)

                # columns (west -> east)
                for c, raw in enumerate(posts):
                    lon_deg = lon_start_deg + c * lon_res_deg

                    if raw == no_data:
                        out.write(f"{lon_deg:.10f};{lat_deg:.10f};{raw};\n; \n".replace(";;", ";"))
                        # The above may create odd formatting; so just do explicit:
                        out.write(f"{lon_deg:.10f};{lat_deg:.10f};{raw};{''};{''};{''}\n")
                        continue

                    elev_m = raw / scale_divisor

                    off, elev_real_raw = water_offset_guess(raw, no_data)
                    if off is None:
                        out.write(f"{lon_deg:.10f};{lat_deg:.10f};{raw};{elev_m:.3f};;;;\n".replace(";;;;", ";;;"))  # keep consistent
                        # safer explicit:
                        out.write(f"{lon_deg:.10f};{lat_deg:.10f};{raw};{elev_m:.3f};;\n".rstrip() + ";\n".rstrip() + "\n")
                    else:
                        # elev_real_raw = raw - offset (in raw units)
                        elev_m_real = elev_real_raw / scale_divisor
                        out.write(f"{lon_deg:.10f};{lat_deg:.10f};{raw};{elev_m:.3f};{off};{elev_m_real:.3f}\n")


if __name__ == "__main__":
    if len(sys.argv) != 3:
        print("Usage: python3 extract_elv_to_txt.py <path_to_file.elv> <output.txt>")
        sys.exit(1)

    extract_elv_to_txt(sys.argv[1], sys.argv[2])
    print(f"OK -> {sys.argv[2]}")
